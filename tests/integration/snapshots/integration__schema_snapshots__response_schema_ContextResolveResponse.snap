---
source: tests/integration/schema_snapshots.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextResolveResponse",
  "description": "Response from `context_resolve`.",
  "type": "object",
  "properties": {
    "resolution": {
      "description": "Governed resolution details.",
      "$ref": "#/$defs/ContextResolution"
    },
    "catalog": {
      "description": "Authorized catalog page for an empty query.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextDescriptor"
      }
    },
    "next_offset": {
      "description": "Next catalog offset when a full page was returned.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "resolution",
    "catalog"
  ],
  "$defs": {
    "ContextResolution": {
      "description": "Agent-facing governed context resolution.",
      "type": "object",
      "properties": {
        "direct": {
          "description": "Directly selected contexts in caller order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextDescriptor"
          }
        },
        "effective": {
          "description": "Direct selections plus ancestors and optional descendants.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextDescriptor"
          }
        },
        "candidates": {
          "description": "Authorized ambiguous or fuzzy candidates.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextCandidate"
          }
        },
        "policy_guidance": {
          "description": "Effective policy guidance.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "broad_search": {
          "description": "Whether omission intentionally selected a broad authorized search.",
          "type": "boolean"
        },
        "unresolved": {
          "description": "Whether resolution remains intentionally deferred.",
          "type": "boolean"
        },
        "recommended_actions": {
          "description": "Reusable recommended actions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecommendedAction"
          }
        }
      },
      "required": [
        "direct",
        "effective",
        "candidates",
        "policy_guidance",
        "broad_search",
        "unresolved",
        "recommended_actions"
      ]
    },
    "ContextDescriptor": {
      "description": "Safe context descriptor returned on memory cards and resolution results.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable opaque ID.",
          "$ref": "#/$defs/ContextId"
        },
        "kind": {
          "description": "Context kind.",
          "$ref": "#/$defs/ContextKind"
        },
        "key": {
          "description": "Immutable context key.",
          "type": "string"
        },
        "display_name": {
          "description": "Human-readable display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "key",
        "display_name"
      ]
    },
    "ContextId": {
      "description": "A ULID-formatted opaque context identifier",
      "type": "string"
    },
    "ContextKind": {
      "description": "Stable context kind. Built-in kinds and operator-defined kinds use the same\nrepresentation so adding a kind does not require a wire-protocol change.",
      "type": "string"
    },
    "ContextCandidate": {
      "description": "Fuzzy or ambiguous authorized context candidate.",
      "type": "object",
      "properties": {
        "context": {
          "description": "Safe context descriptor.",
          "$ref": "#/$defs/ContextDescriptor"
        },
        "score": {
          "description": "Similarity score from 0.0 to 1.0.",
          "type": "number",
          "format": "double"
        },
        "matched_by": {
          "description": "Matching surfaces, such as key, display name, alias, identity, or hint.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "context",
        "score",
        "matched_by"
      ]
    },
    "RecommendedAction": {
      "description": "Deterministic next action recommended by `brief`.",
      "type": "object",
      "properties": {
        "tool": {
          "description": "Tool to call next.",
          "$ref": "#/$defs/RecommendedActionTool"
        },
        "priority": {
          "description": "Action priority.",
          "$ref": "#/$defs/RecommendedActionPriority"
        },
        "reason": {
          "description": "Why this action is recommended.",
          "type": "string"
        },
        "arguments": {
          "description": "Complete tool arguments when the server can construct a valid call."
        }
      },
      "required": [
        "tool",
        "priority",
        "reason"
      ]
    },
    "RecommendedActionTool": {
      "description": "Tool name for a deterministic next action recommended by `brief`.",
      "oneOf": [
        {
          "description": "Read one full memory by ID.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Read multiple full memories by ID.",
          "type": "string",
          "const": "read_many"
        },
        {
          "description": "Run a focused recall search.",
          "type": "string",
          "const": "recall"
        },
        {
          "description": "Store a new durable memory.",
          "type": "string",
          "const": "remember"
        },
        {
          "description": "Resolve or browse governed contexts.",
          "type": "string",
          "const": "context_resolve"
        },
        {
          "description": "Create a governed context.",
          "type": "string",
          "const": "context_create"
        },
        {
          "description": "Register a missing scope definition.",
          "type": "string",
          "const": "admin_scope_register"
        }
      ]
    },
    "RecommendedActionPriority": {
      "description": "Priority for a deterministic next action recommended by `brief`.",
      "oneOf": [
        {
          "description": "Do this first.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Useful but not urgent.",
          "type": "string",
          "const": "normal"
        },
        {
          "description": "Optional follow-up for weak or stale context.",
          "type": "string",
          "const": "low"
        }
      ]
    }
  }
}
